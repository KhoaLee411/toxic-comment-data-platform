# =============================================================================
# Monitoring Stack — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Grafana
# -----------------------------------------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me_strong_password

# -----------------------------------------------------------------------------
# Discord webhook for Alertmanager notifications
# How to create: Server Settings → Integrations → Webhooks → New Webhook
# -----------------------------------------------------------------------------
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_ID/YOUR_TOKEN

# -----------------------------------------------------------------------------
# ELK Stack (only needed when running elk-compose.yml)
# -----------------------------------------------------------------------------
ELASTIC_VERSION=8.7.1

# Passwords — must be at least 6 characters
ELASTIC_PASSWORD=change_me_elastic
LOGSTASH_INTERNAL_PASSWORD=change_me_logstash
KIBANA_SYSTEM_PASSWORD=change_me_kibana